# Copy to .env.development, .env.homolog, or .env.production and fill in.
# Never commit a populated env file — `.env*` is gitignored.

NODE_ENV=
PORT=

# Host UID/GID used as Docker build args (must match the host "apps" user — typically 1003)
HOST_UID=
HOST_GID=

# LDAP — used by /api/login (LoginService)
LDAP_SERVER=
LDAP_PORT=
LDAP_PASSWORD=
LDAP_BASE=
LDAP_BIND_DN=
LDAP_UID=

# Demeter database (Prisma)
DATABASE_URL=
DATABASE_URL_CAFE=
DB_PASS=

# Locally owned cache database (atendimentos refresh job and aggregates route)
CACHE_DATABASE_URL=
# Cache container credentials, interpolated by docker-compose.postgres-dev.yaml (--env-file)
CACHE_DB_NAME=
CACHE_DB_USER=
CACHE_DB_PASSWORD=
# In-process nightly cache refresh scheduler; only the exact value "true" enables it (hmg/prod only)
CACHE_JOBS_ENABLED=
# Optional cron pattern (America/Sao_Paulo) for that refresh; empty means 01:00. hmg sets a later time because it shares the VM with prod
CACHE_JOBS_ATENDIMENTOS_REFRESH_CRON=

# Service-to-service JWT signing secret (Bearer token verified in auth middleware)
SERVICE_TOKEN=

# Paths (host-side)
HOME_FOLDER=
LOGS_FOLDER=
